[
 {
  "line": "L01",
  "text": "Привет, хотим рассказать отличную новость",
  "from": 0.22,
  "to": 2.76,
  "minW": 952,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L02",
  "text": "Теперь за благодарность от клиента",
  "from": 2.78,
  "to": 4.658,
  "minW": 956,
  "minH": 74,
  "cy": 979.0
 },
 {
  "line": "L02",
  "text": "ты можешь получить ачивку",
  "from": 4.638,
  "to": 6.699,
  "minW": 756,
  "minH": 74,
  "cy": 979.0
 },
 {
  "line": "L03",
  "text": "Эксперт сервиса. Получил благодарность от клиента",
  "from": 15.32,
  "to": 18.508,
  "minW": 620,
  "minH": 104,
  "cy": 980.0
 },
 {
  "line": "L04",
  "text": "Давай посмотрим,",
  "from": 21.91,
  "to": 22.638,
  "minW": 0,
  "minH": 0,
  "cy": 979
 },
 {
  "line": "L04",
  "text": "что за ачивки",
  "from": 22.618,
  "to": 23.46,
  "minW": 0,
  "minH": 0,
  "cy": 979
 },
 {
  "line": "L05",
  "text": "Условия зависят от направления:",
  "from": 23.48,
  "to": 25.067,
  "minW": 0,
  "minH": 0,
  "cy": 979
 },
 {
  "line": "L05",
  "text": "благодарности клиентов,",
  "from": 25.047,
  "to": 26.216,
  "minW": 0,
  "minH": 0,
  "cy": 979
 },
 {
  "line": "L05",
  "text": "топ по положительным оценкам",
  "from": 26.197,
  "to": 27.479,
  "minW": 0,
  "minH": 0,
  "cy": 979
 },
 {
  "line": "L05",
  "text": "или зачтённые WOW-диалоги.",
  "from": 27.459,
  "to": 29.542,
  "minW": 0,
  "minH": 0,
  "cy": 979
 },
 {
  "line": "L05",
  "text": "Точные условия — в описании ачивки",
  "from": 29.522,
  "to": 31.7,
  "minW": 0,
  "minH": 0,
  "cy": 979
 },
 {
  "line": "L06",
  "text": "Ну а стать мастером сервиса — это уже на уровне,",
  "from": 31.72,
  "to": 34.306,
  "minW": 860,
  "minH": 126,
  "cy": 979.0
 },
 {
  "line": "L06",
  "text": "когда клиенты просят номер карты,",
  "from": 34.286,
  "to": 36.117,
  "minW": 600,
  "minH": 126,
  "cy": 981.0
 },
 {
  "line": "L06",
  "text": "чтобы скинуть тебе деньги за помощь",
  "from": 36.097,
  "to": 37.45,
  "minW": 600,
  "minH": 126,
  "cy": 981.0
 },
 {
  "line": "L07",
  "text": "И как же получить такие ачивки?",
  "from": 39.66,
  "to": 41.64,
  "minW": 548,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L08",
  "text": "Шаг 1.",
  "from": 41.66,
  "to": 42.4,
  "minW": 207,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L08",
  "text": "Консультация должна быть чёткой,",
  "from": 42.38,
  "to": 43.909,
  "minW": 644,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L08",
  "text": "как инструкция к микроволновке",
  "from": 43.889,
  "to": 45.49,
  "minW": 520,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L09",
  "text": "Шаг 2.",
  "from": 45.51,
  "to": 46.192,
  "minW": 207,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L09",
  "text": "Клиент, счастливый и довольный консультацией,",
  "from": 46.172,
  "to": 48.665,
  "minW": 932,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L09",
  "text": "оставляет благодарность",
  "from": 48.645,
  "to": 49.94,
  "minW": 732,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L10",
  "text": "Шаг 3.",
  "from": 49.96,
  "to": 50.816,
  "minW": 207,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L10",
  "text": "Эксперт контроля качества проверяет благодарность",
  "from": 50.796,
  "to": 53.34,
  "minW": 780,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L11",
  "text": "Важно то, что учитываются только корректные консультации",
  "from": 53.36,
  "to": 56.24,
  "minW": 972,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L12",
  "text": "Каждый месяц эксперты",
  "from": 56.26,
  "to": 57.604,
  "minW": 748,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L12",
  "text": "контроля качества сводят статистику",
  "from": 57.584,
  "to": 59.44,
  "minW": 748,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L13",
  "text": "Клиентские благодарности копятся",
  "from": 59.46,
  "to": 61.152,
  "minW": 992,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L13",
  "text": "как бонусы на карте лояльности",
  "from": 61.132,
  "to": 63.14,
  "minW": 908,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L14",
  "text": "Ачивки присуждаем ежемесячно",
  "from": 63.16,
  "to": 65.09,
  "minW": 928,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L15",
  "text": "Твои старания не останутся незамеченными",
  "from": 65.11,
  "to": 67.54,
  "minW": 792,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L16",
  "text": "Всю эту информацию ты можешь найти в Alfa People",
  "from": 67.56,
  "to": 70.19,
  "minW": 884,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L17",
  "text": "Нажимаешь на раздел «Помощь»,",
  "from": 70.21,
  "to": 71.774,
  "minW": 892,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L17",
  "text": "а потом кликаешь на вкладку «Как работают ачивки»",
  "from": 71.754,
  "to": 74.69,
  "minW": 834,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L18",
  "text": "Вводишь в поиск слово «эксперт»,",
  "from": 74.71,
  "to": 76.39,
  "minW": 960,
  "minH": 78,
  "cy": 979.0
 },
 {
  "line": "L18",
  "text": "и справа появится вкладка с информацией по этим ачивкам",
  "from": 76.37,
  "to": 79.163,
  "minW": 912,
  "minH": 126,
  "cy": 981.0
 },
 {
  "line": "L19",
  "text": "А ты уже получал благодарности?",
  "from": 80.96,
  "to": 82.896,
  "minW": 532,
  "minH": 122,
  "cy": 979.0
 },
 {
  "line": "L19",
  "text": "Поделись в комментариях, как это было",
  "from": 82.876,
  "to": 85.39,
  "minW": 696,
  "minH": 123,
  "cy": 966.5
 }
]